# --- Server ---
PORT=3001
# Where the web app is served (used for OAuth redirects and CORS)
APP_URL=http://localhost:5173
# Public URL of the API (OAuth callback = $API_URL/api/auth/google/callback)
API_URL=http://localhost:5173
DATABASE_URL=postgres://lumo:lumo@localhost:5432/lumo
# Long random string: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Requests per minute per IP (auth endpoints have their own stricter limits)
RATE_LIMIT_PER_MIN=300

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email sign-in codes (leave empty in dev: codes are printed to the server log) ---
SMTP_URL=
MAIL_FROM="Revio <hello@example.com>"

# --- Anthropic (server-side only, never exposed to the browser) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Model used to grade open answers. Set to claude-haiku-5-5 to cut grading cost.
AI_GRADING_MODEL=claude-opus-5-5

# Production only: serve the built web app from this folder (development uses Vite on :5173)
WEB_DIST=
