    "@fastify/static": "^8.3.0",
    "@lumo/core": "0.1.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "nodemailer": "^8.0.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "vitest": "^4.1.11"
