{
  "name": "lumo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,magenta \"npm run dev -w @lumo/server\" \"npm run dev -w @lumo/web\"",
    "build": "npm run build -w @lumo/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run migrate -w @lumo/server",
    "start": "npm run start -w @lumo/server"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.2.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
